{
  "opencollection": "1.0.0",
  "info": {
    "name": "Imgur Auth API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authorize User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.imgur.com/oauth2/authorize",
            "params": [
              {
                "name": "client_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "response_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Begin the OAuth2 authorization-code or token grant flow."
        },
        {
          "info": {
            "name": "Issue Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.imgur.com/oauth2/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                },
                {
                  "name": "pin",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange an authorization code, refresh token, or PIN for an access token."
        }
      ]
    }
  ],
  "bundled": true
}